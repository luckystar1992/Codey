# companion/.env.example — 复制为 companion/.env 并填值(asr_stream 启动时自动加载)
# ASR 引擎: sherpa(本地默认) | doubao | tencent | auto(配齐谁的 key 用谁,优先级 tencent>doubao>sherpa)
CODEY_ASR_ENGINE=auto
# 粘贴桥: 1=转写后粘贴到当前窗口(默认), 0=只回传手表显示
CODEY_PASTE=1
# 粘贴后自动回车提交(默认 0;固件 BtnB 也能发 submit)
CODEY_PASTE_AUTO_ENTER=0
# 豆包(火山引擎)凭据 —— 仅 doubao 引擎需要。volcengine.com 开通"大模型流式语音识别"(文档 6561/1354869)
# DOUBAO_API_KEY=控制台 Access Token(请求头 x-api-key/X-Api-Access-Key)
# DOUBAO_APP_ID =控制台 App ID(请求头 X-Api-App-Key)
DOUBAO_API_KEY=
DOUBAO_APP_ID=
# 可选覆盖(默认走大模型流式 bigasr;一般不用改):
# 并发版改 volc.bigasr.sauc.concurrent;若开通的是 seed-asr V2 则改 volc.seedasr.sauc.duration
# DOUBAO_STREAMING_RESOURCE_ID=volc.bigasr.sauc.duration
# DOUBAO_RESOURCE_ID=volc.bigasr.auc
# 腾讯云实时 ASR 凭据 —— 三件套齐才用腾讯。cloud.tencent.com 控制台获取(语音识别 → 实时语音识别)
TENCENT_APPID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# 可选:引擎模型(默认 16k_zh):16k_zh / 16k_zh_large / 16k_en ...
# TENCENT_ENGINE=16k_zh
# --- 远程访问(ngrok)——仅 tunnel.sh / 远程模式需要 ---
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
NGROK_BASIC_AUTH=codey:change-me-to-a-long-secret
